# Preserve model-source fingerprints and script behavior across Windows/Linux.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.ico binary
# Preserve upstream attribution files byte-for-byte for their recorded hashes.
desktop/licenses/* -text
